{
  "manifest_version": 3,
  "name": "Predecessores no card (Azure Boards)",
  "short_name": "Predecessores",
  "version": "0.1.0",
  "description": "Mostra nos cards do board e do taskboard do Azure Boards os predecessores ainda não concluídos.",
  "homepage_url": "https://github.com/ivetech-sistemas/ado-boards-predecessor",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://dev.azure.com/*",
    "https://*.visualstudio.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://dev.azure.com/*",
        "https://*.visualstudio.com/*"
      ],
      "js": ["content.js"],
      "css": ["estilos.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "opcoes.html",
    "open_in_tab": false
  }
}
